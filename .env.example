# Copy to .env.local and fill in. Every value is optional: without it the
# related feature falls back to a static number or a neutral state rather than
# showing something invented.

# YouTube subscriber count.
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
# Free tier is 10,000 units/day; this site uses ~1 unit per revalidation.
YOUTUBE_API_KEY=

# Twitch live/offline status, follower total, last VOD, and clips.
# Client ID + Client Secret *is* the Twitch API access — there is no separate
# "API key". Register at dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:3000
#   Category: Website Integration
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Extra hostnames allowed to embed the Twitch player, comma separated.
# localhost and superzydanofficial.com are always included.
NEXT_PUBLIC_TWITCH_PARENTS=

# Discord member/online counts need no configuration — they come from the
# public invite endpoint using the invite code in lib/site.ts.
#
# Optional WidgetBot overrides for the Community page live-chat iframe.
# Defaults in lib/site.ts already point at Zydan's Digital Domain #general.
# NEXT_PUBLIC_DISCORD_SERVER_ID=
# NEXT_PUBLIC_DISCORD_CHANNEL_ID=

# Instagram follower count is not wired up yet: it requires a Facebook app,
# an Instagram Business/Creator account linked to a Facebook Page, and a
# long-lived Graph API token that has to be refreshed every 60 days.
